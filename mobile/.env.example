# Copy with --dart-define or via `flutter run --dart-define-file=.env.local`.
# Example:
#   flutter run --dart-define=API_BASE_URL=http://10.0.2.2:8000
API_BASE_URL=http://10.0.2.2:8000
# Asset file names (all tracked conversion artifacts — see README).
CNN_MODEL_ASSET=assets/models/pneumonia_resnet50.onnx
CNN_BACKEND=onnx
SLM_GGUF_ASSET=assets/models/slm_norm_q4.gguf
# Eager (true) loads both models at startup; false loads lazily on first use.
EAGER_MODEL_LOAD=false
