# IntelliMed on-device app — runtime configuration template.
#
# Copy this file to `.env` (gitignored) and fill in real values:
#   copy .env.example .env
#
# Flutter does NOT auto-load .env files. Apply the file explicitly:
#   flutter run --dart-define-from-file=.env
#   flutter build apk --release --dart-define-from-file=.env
#
# Or pass values inline (these take precedence over the file):
#   flutter run --dart-define=API_BASE_URL=http://10.0.2.2:8000

# Backend ORIGIN ONLY — the app appends the route itself:
#   POST {API_BASE_URL}/api/v2/lab-reports/upload-structured   (sync)
#   POST {API_BASE_URL}/api/v1/auth/google-login               (sign-in)
#
# Must NOT include a trailing `/api` or `/api/vN`.
#
# Targets (pick one):
#   Deployed backend (physical device, any network)  : https://<your-app>.modal.run
#   Android emulator, backend on this machine        : http://10.0.2.2:8000
#   iOS simulator                                    : http://localhost:8000
#   Physical device, backend on this machine         : http://<LAN-IP>:8000
#     (device and PC on the same Wi-Fi; plain HTTP only works in debug builds)
API_BASE_URL=http://10.0.2.2:8000

# Optional OAuth bypass: paste a patient JWT to skip Google sign-in entirely
# (useful when the consent screen / test-user setup isn't ready yet).
# Leave empty for normal Google sign-in.
AUTH_TOKEN=

# WEB OAuth client ID for your Google Cloud project (NOT the Android one).
# Sent to Google as `serverClientId` so the returned idToken is audienced to
# the backend's GOOGLE_CLIENT_ID; without it Android throws
# GoogleSignInExceptionCode.clientConfigurationError.
#
# Find it in Google Cloud Console > APIs & Services > Credentials, under the
# OAuth 2.0 client whose type is "Web application". It is the same value as the
# backend's GOOGLE_CLIENT_ID and the frontend's VITE_GOOGLE_CLIENT_ID.
#
# The Android OAuth client (registered with package name
# ai.intellimed.intellimed_app + signing SHA-1) is matched automatically and is
# NEVER referenced here.
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Tracked model assets (see assets/models/).
CNN_MODEL_ASSET=assets/models/pneumonia_resnet50.onnx
SLM_GGUF_ASSET=assets/models/slm_norm_q4.gguf

# Eager (true) loads both models at startup; false loads lazily on first use.
# Lazy is the measured default (see docs/MEMORY_REPORT.md).
EAGER_MODEL_LOAD=false

# Reserved: read in lib/main.dart but not yet plumbed into ModelManager, which
# always uses the ONNX backend (see docs/APP_SPIKE.md).
CNN_BACKEND=onnx
