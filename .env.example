# Root-level variables interpolated by docker-compose.yml.
# Copy to `.env` (gitignored) before running `docker compose up --build`.
#
# Note: the backend container's own config comes from backend/.env via
# `env_file`. These values only fill the ${...} substitutions in compose.

# Injected into the frontend dev container as the Google OAuth client id.
VITE_GOOGLE_CLIENT_ID=

# Set to 1 to download the optional spaCy model into the backend image.
INSTALL_SPACY_MODEL=0

# Override the hybrid OCR sidecar URL (defaults to the compose service name).
LAB_OPENDATALOADER_HYBRID_URL=http://lab-hybrid:5002
