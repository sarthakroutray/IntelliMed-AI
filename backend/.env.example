# Google OAuth2 Configuration
# Get these from Google Cloud Console:
# https://console.cloud.google.com/

GOOGLE_CLIENT_ID=your_google_client_id_here

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
# Regex alternative for preview deployments, e.g. https://.*\.vercel\.app
CORS_ORIGIN_REGEX=

# Supabase Storage
# Project URL from Settings > API in Supabase dashboard
SUPABASE_URL=https://your_project_id.supabase.co
# Service Role key (secret) from Settings > API – keep this private
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
# Name of the storage bucket to use (create it in Supabase Storage)
SUPABASE_STORAGE_BUCKET=medical-documents

# Upload limits & caching
# Maximum allowed upload size in megabytes (default: 10)
MAX_UPLOAD_SIZE_MB=10
# How long (seconds) document GET responses are cached in memory (default: 300)
CACHE_TTL_SECONDS=300

# Database Configuration (Supabase)
DATABASE_URL=postgresql://postgres:your_password@db.yourdomain.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:your_password@db.yourdomain.supabase.co:5432/postgres
SECRET_KEY=replace_with_a_long_random_secret

# Optional OpenDataLoader PDF settings
USE_OPENDATALOADER_FOR_PDFS=true
OPENDATALOADER_USE_STRUCT_TREE=true
OPENDATALOADER_HYBRID=off
OPENDATALOADER_HYBRID_URL=
OPENDATALOADER_HYBRID_TIMEOUT=30000
