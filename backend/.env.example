# Google OAuth2 Configuration
# Get these from Google Cloud Console:
# https://console.cloud.google.com/

GOOGLE_CLIENT_ID=your_google_client_id_here

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
# Regex alternative for preview deployments, e.g. https://.*\.vercel\.app
CORS_ORIGIN_REGEX=

# Supabase Storage
# Project URL from Settings > API in Supabase dashboard
SUPABASE_URL=https://your_project_id.supabase.co
# Service Role key (secret) from Settings > API – keep this private
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
# Name of the storage bucket to use (create it in Supabase Storage)
SUPABASE_STORAGE_BUCKET=medical-documents
# Signed URL lifetime in seconds for private document access
SUPABASE_SIGNED_URL_EXPIRES_SECONDS=300

# Upload limits & caching
# Maximum allowed upload size in megabytes (default: 10)
MAX_UPLOAD_SIZE_MB=10
# How long (seconds) document GET responses are cached in memory (default: 300)
CACHE_TTL_SECONDS=300
# Max concurrent heavy AI jobs (OCR/CV/summarize); others wait (default: 2)
MAX_CONCURRENT_HEAVY=2

# In-process request cache TTLs (seconds) and size cap
AUTH_USER_CACHE_TTL_SECONDS=60
DOCTOR_PATIENT_CACHE_TTL_SECONDS=120
REQUEST_CACHE_MAX_ENTRIES=4096

# Database Configuration (Supabase)
DATABASE_URL=postgresql://postgres:your_password@db.yourdomain.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:your_password@db.yourdomain.supabase.co:5432/postgres
SECRET_KEY=replace_with_a_long_random_secret
DOCTOR_ACCESS_CODE=replace_with_private_doctor_registration_code
ADMIN_EMAIL=admin@intellimed.ai
ADMIN_PASSWORD=replace_with_strong_admin_password

# Optional OpenDataLoader PDF settings
USE_OPENDATALOADER_FOR_PDFS=true
OPENDATALOADER_USE_STRUCT_TREE=true
OPENDATALOADER_HYBRID=off
OPENDATALOADER_HYBRID_URL=
OPENDATALOADER_HYBRID_TIMEOUT=30000

# Lab report pipeline (v2) — Stage 1 extraction
# Hybrid OCR backend (opendataloader-pdf[hybrid]) for scanned/image-based PDFs.
# Set LAB_OPENDATALOADER_HYBRID=docling-fast and start the backend server:
#   opendataloader-pdf-hybrid --port 5002
# then point LAB_OPENDATALOADER_HYBRID_URL at it (e.g. http://lab-hybrid:5002 in docker compose).
# Without it, scanned PDFs and images fall back to EasyOCR (text only, no bounding boxes).
LAB_OPENDATALOADER_HYBRID=off
LAB_OPENDATALOADER_HYBRID_MODE=full
LAB_OPENDATALOADER_HYBRID_URL=
LAB_OPENDATALOADER_HYBRID_TIMEOUT=30000
LAB_MIN_EXTRACT_TEXT_CHARS=40

# Lab report pipeline (v2) — Stage 2 SLM backend (optional)
# Leave LAB_SLM_PROVIDER empty to use the built-in deterministic normalizer.
# LAB_SLM_PROVIDER=openai-compatible
# LAB_SLM_URL=http://localhost:1234/v1/chat/completions
# LAB_SLM_MODEL=
# LAB_SLM_API_KEY=

# T5 medical text summarizer (shared backend + on-device checkpoint)
# HuggingFace model id; defaults to Falconsai/medical_summarization.
MEDICAL_SUMMARIZER_MODEL=Falconsai/medical_summarization
SUMMARY_MAX_LENGTH=512
SUMMARY_MIN_LENGTH=60
SUMMARIZER_MAX_INPUT_CHARS=3000
